<div class="actor-sheet character cpr-alt-layout">
  <aside class="cpr-alt-essentials" aria-label="Informações essenciais"
         {{#if altCanSeeDetails}}style="--cpr-alt-hp: {{altHpPercent}}%"{{/if}}>
    <p class="cpr-alt-sidebar-heading">Informações essenciais</p>
    {{> "modules/cpr-ficha-alternativa/templates/essentials.hbs"}}
  </aside>

  {{#if altCanSeeDetails}}
    <div class="cpr-alt-category">
      <nav class="navtabs-right cpr-alt-tabs" data-group="primary" aria-label="Categorias da ficha">
        <button type="button" data-tab="lifepath">História</button>
        <button type="button" data-tab="skills">Perícias</button>
        <button type="button" data-tab="gear">Equipamento</button>
        <button type="button" data-tab="cyberware">Cibernética</button>
        <button type="button" data-tab="role">Funções</button>
        <button type="button" data-tab="fight">Combate</button>
        <button type="button" data-tab="effects">Efeitos</button>
      </nav>

      <div class="right-content-section">
        <section class="tab lifepath-tab" data-group="primary" data-tab="lifepath" aria-label="História">
          {{> "systems/cyberpunk-red-core/templates/actor/character/bottom-pane/cpr-lifepath-tab.hbs"}}
        </section>

        <section class="tab skills-tab" data-group="primary" data-tab="skills" aria-label="Perícias">
          <section class="cpr-alt-attributes" aria-label="Atributos do personagem">
            {{> "systems/cyberpunk-red-core/templates/actor/character/left-pane/cpr-left-pane-stats.hbs"}}
          </section>
          <label class="cpr-alt-skill-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" placeholder="Buscar perícia…" aria-label="Buscar perícia">
          </label>
          <div class="cpr-alt-skill-options" role="group" aria-label="Opções da lista de perícias">
            <label>Denso <input type="checkbox" role="switch" data-skill-option="dense"></label>
            <label>Agrupar <input type="checkbox" role="switch" data-skill-option="grouped"></label>
            <label>Esconder zeradas <input type="checkbox" role="switch" data-skill-option="hideZero"></label>
          </div>
          <p class="cpr-alt-skill-empty" role="status" hidden>Nenhuma perícia encontrada.</p>
          {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/cpr-skills.hbs"}}
        </section>

        <section class="tab gear-tab" data-group="primary" data-tab="gear" aria-label="Equipamento">
          <nav class="cpr-alt-inventory-tabs" aria-label="Categorias de equipamento">
            {{#each altInventoryCategories}}
              <button type="button" data-inventory-category="{{id}}" aria-pressed="false">
                {{label}}
              </button>
            {{/each}}
          </nav>
          <p class="cpr-alt-inventory-empty" role="status" hidden>Nenhum item para mostrar nesta categoria.</p>
          {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/cpr-gear.hbs"}}
        </section>

        <section class="tab cyberware-tab" data-group="primary" data-tab="cyberware" aria-label="Cibernética">
          {{> "modules/cpr-ficha-alternativa/templates/cyberware-map.hbs"}}
        </section>

        <section class="tab role-tab" data-group="primary" data-tab="role" aria-label="Funções">
          {{> "systems/cyberpunk-red-core/templates/actor/character/bottom-pane/cpr-role-tab.hbs"}}
        </section>

        <section class="tab fight-tab" data-group="primary" data-tab="fight" aria-label="Combate e Netrunning">
          {{#if (cprCompare fightData.fightOptions "===" "both")}}
            <div class="cpr-alt-combat-modes" aria-label="Modo de combate">
              {{#if (cprCompare fightData.fightState "===" "Netspace")}}
                {{#if editable}}
                  <button type="button" class="toggle-fight-state" data-state="Meatspace">Combate físico</button>
                {{/if}}
                <span class="cpr-alt-mode-current">Netrunning</span>
              {{else}}
                <span class="cpr-alt-mode-current">Combate físico</span>
                {{#if editable}}
                  <button type="button" class="toggle-fight-state" data-state="Netspace">Netrunning</button>
                {{/if}}
              {{/if}}
            </div>
          {{/if}}
          {{> "systems/cyberpunk-red-core/templates/actor/character/bottom-pane/cpr-fight-tab.hbs"}}
        </section>

        <section class="tab effects-tab" data-group="primary" data-tab="effects" aria-label="Efeitos">
          {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/cpr-effects.hbs"}}
        </section>
      </div>
    </div>
  {{/if}}
</div>
